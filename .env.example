# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These values are public identifiers (they ship in the browser bundle); security comes from
# firestore.rules and storage.rules. Leave them empty and the RSVP/upload sections show "opening soon".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
