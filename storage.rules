rules_version = '2';

// Guest photos: write-once uploads, images only, 15 MB max. No public reads;
// nothing becomes visible until the couple approves it (future gallery).
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{owner}/{file} {
      allow read, update, delete: if false;
      allow create: if owner.matches('^[A-Za-z0-9_-]{8,64}$')
        && file.matches('^[A-Za-z0-9-]{8,64}[.](jpg|jpeg|png|webp|heic|heif)$')
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp|heic|heif)$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
